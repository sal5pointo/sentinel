# Copy to .env for local overrides. Prefer OS keychain for secrets.
# NEVER put Schwab passwords here. OAuth tokens live encrypted via keyring.

# Absolute path to config directory (defaults to ./config)
# SENTINEL_CONFIG_DIR=/path/to/config

# SQLite path (defaults to ./data/sentinel.db)
# SENTINEL_DB_PATH=/path/to/data/sentinel.db

# Hard gate — must stay false unless the owner flips config + passkey.
# Agents MUST NEVER set this to true.
TRADING_ENABLED=false

# Optional: override keyring service name
# SENTINEL_KEYRING_SERVICE=sentinel

# LLM process (sentinel-llm) — Claude key only; never Schwab credentials
# ANTHROPIC_API_KEY=

# Dead-man heartbeat (optional Phase 0+)
# HEALTHCHECKS_URL=

# Approval HMAC secret (set on Windows host; CI may leave unset for fixture default)
# SENTINEL_APPROVAL_HMAC_SECRET=

# Max confirm price drift percent (default 1.0)
# SENTINEL_MAX_DRIFT_PCT=1.0

# INSECURE — enable WebAuthn bypass for local pytest ONLY. Never on money host.
# SENTINEL_INSECURE_WEBAUTHN_BYPASS=0
